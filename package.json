{
  "name": "dsh-plugin-moss-tts",
  "version": "0.1.1",
  "description": "Local MOSS-TTS speech for DeepSeek Harness: offline CPU synthesis, auto-read of replies, one-click engine download",
  "type": "module",
  "license": "Apache-2.0",
  "author": "litterbit",
  "repository": {
    "type": "git",
    "url": "https://github.com/litterbit/dsh-plugin-moss-tts.git"
  },
  "homepage": "https://github.com/litterbit/dsh-plugin-moss-tts",
  "bugs": {
    "url": "https://github.com/litterbit/dsh-plugin-moss-tts/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tts",
    "text-to-speech",
    "moss-tts",
    "local",
    "offline",
    "voice"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.2",
    "react": "^18.2.0 || ^19.0.0"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "engine.json",
    "screenshots.json",
    "assets/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node tools/build-client.mjs",
    "check": "node tools/build-client.mjs --check",
    "test": "node tools/ci.mjs",
    "test:e2e": "node --test tests/engine-protocol.test.mjs tests/host-e2e.test.mjs"
  }
}
